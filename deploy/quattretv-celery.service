[Unit]
Description=QuattreTV Celery worker (EPG y grabaciones)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=quattre
Group=quattre
WorkingDirectory=/var/www/quattretv
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/var/www/quattretv/venv/bin/celery -A config worker -l info --concurrency=2
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
