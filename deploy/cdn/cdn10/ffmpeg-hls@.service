[Unit]
Description=ffmpeg HLS canal %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=2

# Variables por canal en /home/quattre/canales/%i (SRC, OUT, etc.)
EnvironmentFile=/home/quattre/canales/%i

#Borrar directorio
ExecStartPre=/bin/bash -lc 'OUT_DIR="${OUT:-/dev/shm/hls/%i}"; rm -rf "$OUT_DIR"; mkdir -p "$OUT_DIR"'

ExecStart=/bin/bash -lc '\
  set -eo pipefail; \
  OUT_DIR="${OUT:-/dev/shm/hls/%i}"; \
  mkdir -p "$OUT_DIR"; \
  MODE="${TRANSCODE:-copy}"; \
  # Codecs según modo
  if [[ "$MODE" = "noaac" ]]; then \
    VFLAGS="-c:v copy"; \
    AFLAGS="-c:a copy"; \
  elif [[ "$MODE" = "h264" ]]; then \
    VFLAGS="-c:v libx264 -preset veryfast -profile:v main -g 50 -keyint_min 50 -sc_threshold 0"; \
    AFLAGS="-c:a aac -b:a 128k -ac 2"; \
  else \
    VFLAGS="-c:v copy"; \
    AFLAGS="-c:a aac -b:a 128k -ac 2"; \
  fi; \
  if [ -n "${MAPS:-}" ]; then \
    SELMAPS="$MAPS"; \
  else \
    SELMAPS="-map 0:v? -map 0:a? -map 0:d?"; \
  fi; \
  exec /usr/bin/ffmpeg -loglevel ${LOGLEVEL:-warning} -nostats \
    ${INOPTS:--dts_delta_threshold 30} \
    -i ${SRC} \
    $SELMAPS -ignore_unknown \
    $VFLAGS $AFLAGS \
    -f hls -hls_time 10 -hls_list_size 10 \
    -hls_flags delete_segments \
    -hls_segment_type mpegts \
    -strftime 1 -hls_segment_filename "$OUT_DIR/segment_%%Y-%%m-%%d_%%H-%%M-%%S.ts" \
    "$OUT_DIR/index.m3u8"'

[Install]
WantedBy=multi-user.target

