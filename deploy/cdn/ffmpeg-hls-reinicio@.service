[Unit]
# Reinicio programado de un canal. Pensado para los que van perdiendo la
# sincronia del audio con las horas: el reloj de audio del emisor y el de video
# no van exactamente iguales, el sonido se va deslizando y con el paso de los
# dias se nota. Reiniciar realinea todo desde cero.
Description=Reinicio programado del canal %i

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl restart ffmpeg-hls@%i
