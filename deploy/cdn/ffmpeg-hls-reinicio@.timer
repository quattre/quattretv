[Unit]
Description=Reinicio nocturno del canal %i

[Timer]
# A las 5 de la madrugada, cuando no lo esta viendo nadie. El corte dura los
# pocos segundos que tarda ffmpeg en volver a enganchar el multicast.
OnCalendar=*-*-* 05:00:00
RandomizedDelaySec=300
Persistent=false

[Install]
WantedBy=timers.target
