# Django
# Genera una clave propia: los tokens de sesión y los enlaces temporales del
# archivo se firman con ella.
SECRET_KEY=your-secret-key-here-change-in-production
# En produccion SIEMPRE False: con DEBUG las trazas de error exponen la
# configuracion y Django acumula en memoria todas las consultas SQL.
DEBUG=False
# Dominios reales, nunca "*"
ALLOWED_HOSTS=localhost,127.0.0.1

# URL publica de este middleware. Los decos y las TV la usan para pedir las
# playlists de catchup que genera el portal.
PUBLIC_URL=http://localhost:8000

# Database
DB_NAME=quattretv
DB_USER=quattretv
DB_PASSWORD=quattretv
DB_HOST=localhost
DB_PORT=5432

# Redis (cache y broker de Celery; sin esto no hay EPG ni grabaciones)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# Streaming Server
STREAMING_SERVER_URL=http://localhost:8080
TIMESHIFT_ENABLED=True
TIMESHIFT_HOURS=24

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
